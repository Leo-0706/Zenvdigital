# Payment Reminder runs daily at 9:00 AM UTC
PAYMENT_REMINDER_CRON="0 9 * * *"
AUTO_APPROVAL_HOURS=48

# =====================================================================
# Supabase Cloud Database (PostgreSQL)
# Find in: Supabase Dashboard -> Project Settings -> API
# When configured, the system connects directly to your cloud Supabase database.
# When left blank, the system safely uses local SQLite (zenv_digital.sqlite).
# =====================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret

